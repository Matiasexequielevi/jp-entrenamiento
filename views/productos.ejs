<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>JP Entrenamiento | Productos</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    :root{
      --jp-primary:#223a73;
      --jp-primary-2:#2f4f9a;
      --jp-accent:#7ea7ff;
      --jp-soft:#dfe8ff;
      --jp-bg:#f4f7fc;
      --jp-card:#ffffff;
      --jp-text:#1f2937;
      --jp-muted:#6b7280;
      --jp-success:#159447;
      --jp-danger:#d62839;
      --jp-warning:#d4a017;
      --jp-info:#0d6efd;
      --jp-shadow:0 10px 30px rgba(27,47,95,.10);
      --jp-shadow-strong:0 20px 40px rgba(27,47,95,.14);
      --jp-radius:22px;
    }

    *{
      box-sizing:border-box;
    }

    body{
      margin:0;
      min-height:100vh;
      color:var(--jp-text);
      font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background:
        radial-gradient(circle at top left, rgba(126,167,255,.15), transparent 26%),
        radial-gradient(circle at top right, rgba(34,58,115,.12), transparent 28%),
        linear-gradient(180deg, #f8fbff 0%, var(--jp-bg) 100%);
      position:relative;
    }

    body::before{
      content:"";
      position:fixed;
      inset:0;
      background-image:url('/images/logo-jp.png');
      background-repeat:repeat;
      background-size:110px;
      opacity:.035;
      z-index:0;
      pointer-events:none;
    }

    .contenido,
    .main-header,
    .footer{
      position:relative;
      z-index:1;
    }

    .main-header{
      background:linear-gradient(135deg, var(--jp-primary) 0%, var(--jp-primary-2) 100%);
      color:#fff;
      overflow:hidden;
      box-shadow:0 12px 28px rgba(34,58,115,.18);
    }

    .main-header::before{
      content:'';
      position:absolute;
      inset:0;
      background:
        radial-gradient(circle at 12% 20%, rgba(255,255,255,.18), transparent 18%),
        radial-gradient(circle at 88% 16%, rgba(255,255,255,.12), transparent 18%),
        radial-gradient(circle at 65% 75%, rgba(255,255,255,.09), transparent 18%);
      pointer-events:none;
    }

    .header-inner{
      position:relative;
      z-index:2;
      padding:28px 0 24px;
    }

    .brand-wrap{
      display:flex;
      align-items:center;
      justify-content:center;
      gap:16px;
      flex-wrap:wrap;
      text-align:center;
    }

    .brand-logo{
      width:84px;
      height:84px;
      object-fit:cover;
      border-radius:50%;
      border:3px solid rgba(255,255,255,.85);
      background:#fff;
      box-shadow:0 10px 25px rgba(0,0,0,.18);
      flex-shrink:0;
    }

    .brand-text h1{
      margin:0;
      font-size:clamp(1.45rem, 3vw, 2.1rem);
      font-weight:800;
      letter-spacing:.2px;
    }

    .brand-text p{
      margin:.35rem 0 0;
      color:rgba(255,255,255,.86);
      font-size:.98rem;
    }

    .page-wrap{
      padding:28px 0 36px;
    }

    .hero-card{
      background:rgba(255,255,255,.88);
      border:1px solid rgba(34,58,115,.08);
      border-radius:28px;
      box-shadow:var(--jp-shadow-strong);
      backdrop-filter:blur(10px);
      overflow:hidden;
      margin-bottom:22px;
    }

    .hero-top{
      padding:24px 24px 18px;
      border-bottom:1px solid rgba(34,58,115,.08);
      background:linear-gradient(180deg, rgba(34,58,115,.05), rgba(34,58,115,.015));
    }

    .hero-head{
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      gap:14px;
      flex-wrap:wrap;
    }

    .hero-title{
      margin:0;
      font-size:clamp(1.35rem, 2.4vw, 2rem);
      font-weight:800;
      color:var(--jp-primary);
    }

    .hero-subtitle{
      margin:.4rem 0 0;
      color:var(--jp-muted);
      font-size:.98rem;
      max-width:760px;
    }

    .hero-actions{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
    }

    .btn-header{
      display:inline-flex;
      align-items:center;
      gap:8px;
      text-decoration:none;
      border:none;
      border-radius:999px;
      padding:11px 18px;
      font-weight:700;
      transition:.18s ease;
      white-space:nowrap;
    }

    .btn-header-back{
      background:#fff;
      color:var(--jp-primary);
      box-shadow:0 10px 20px rgba(34,58,115,.10);
    }

    .btn-header-back:hover{
      transform:translateY(-1px);
      color:var(--jp-primary);
      background:#f3f6ff;
    }

    .btn-header-add{
      background:linear-gradient(135deg, var(--jp-success), #20b45a);
      color:#fff;
      box-shadow:0 10px 22px rgba(21,148,71,.18);
    }

    .btn-header-add:hover{
      color:#fff;
      transform:translateY(-1px);
      filter:brightness(1.03);
    }

    .hero-body{
      padding:22px 24px 24px;
    }

    .stats-grid{
      display:grid;
      grid-template-columns:repeat(4, minmax(0, 1fr));
      gap:16px;
      margin-bottom:22px;
    }

    .summary-card{
      background:#fff;
      border-radius:22px;
      border:1px solid rgba(34,58,115,.08);
      box-shadow:var(--jp-shadow);
      padding:18px;
      position:relative;
      overflow:hidden;
      min-height:142px;
    }

    .summary-card::after{
      content:'';
      position:absolute;
      right:-18px;
      top:-18px;
      width:82px;
      height:82px;
      border-radius:50%;
      background:rgba(34,58,115,.05);
    }

    .summary-top{
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      gap:10px;
      margin-bottom:14px;
      position:relative;
      z-index:1;
    }

    .summary-label{
      margin:0;
      font-size:.88rem;
      color:var(--jp-muted);
      font-weight:700;
    }

    .summary-icon{
      width:44px;
      height:44px;
      border-radius:14px;
      display:flex;
      align-items:center;
      justify-content:center;
      font-size:1.15rem;
      font-weight:800;
      flex-shrink:0;
    }

    .summary-value{
      margin:0 0 8px;
      font-size:1.7rem;
      line-height:1.05;
      font-weight:900;
      color:var(--jp-text);
      position:relative;
      z-index:1;
    }

    .summary-note{
      margin:0;
      color:var(--jp-muted);
      font-size:.84rem;
      position:relative;
      z-index:1;
    }

    .card-primary .summary-icon{
      background:rgba(34,58,115,.10);
      color:var(--jp-primary);
    }

    .card-danger .summary-icon{
      background:rgba(214,40,57,.12);
      color:var(--jp-danger);
    }

    .card-info .summary-icon{
      background:rgba(13,110,253,.12);
      color:var(--jp-info);
    }

    .card-success .summary-icon{
      background:rgba(21,148,71,.12);
      color:var(--jp-success);
    }

    .toolbar{
      display:grid;
      grid-template-columns: minmax(220px, 280px) 1fr;
      gap:14px;
      align-items:center;
      margin-bottom:20px;
    }

    .toolbar-card{
      background:#fff;
      border:1px solid rgba(34,58,115,.08);
      border-radius:20px;
      padding:14px 16px;
      box-shadow:var(--jp-shadow);
    }

    .toolbar-title{
      margin:0 0 4px;
      font-size:.9rem;
      font-weight:800;
      color:var(--jp-primary);
    }

    .toolbar-subtitle{
      margin:0;
      color:var(--jp-muted);
      font-size:.83rem;
    }

    .search-wrap{
      position:relative;
    }

    .search-input{
      width:100%;
      border:none;
      border-radius:16px;
      padding:15px 18px 15px 46px;
      background:#fff;
      box-shadow:var(--jp-shadow);
      border:1px solid rgba(34,58,115,.08);
      font-size:.98rem;
      outline:none;
      transition:.18s ease;
    }

    .search-input:focus{
      border-color:rgba(34,58,115,.28);
      box-shadow:0 12px 24px rgba(34,58,115,.12);
    }

    .search-icon{
      position:absolute;
      left:16px;
      top:50%;
      transform:translateY(-50%);
      color:var(--jp-muted);
      font-size:1rem;
      pointer-events:none;
    }

    .table-card{
      background:#fff;
      border-radius:24px;
      box-shadow:var(--jp-shadow);
      border:1px solid rgba(34,58,115,.08);
      overflow:hidden;
    }

    .table-card-header{
      padding:16px 18px;
      border-bottom:1px solid rgba(34,58,115,.08);
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      flex-wrap:wrap;
      background:linear-gradient(180deg, rgba(34,58,115,.03), rgba(34,58,115,.01));
    }

    .table-card-header h3{
      margin:0;
      font-size:1.02rem;
      font-weight:800;
      color:var(--jp-primary);
    }

    .table-card-header p{
      margin:0;
      color:var(--jp-muted);
      font-size:.9rem;
    }

    .table-responsive{
      margin:0;
    }

    .tabla-productos{
      margin:0;
      vertical-align:middle;
    }

    .tabla-productos thead th{
      background:#18284b;
      color:#fff;
      border:none;
      font-size:.86rem;
      text-transform:uppercase;
      letter-spacing:.3px;
      padding:15px 12px;
      white-space:nowrap;
      text-align:center;
    }

    .tabla-productos tbody td{
      padding:14px 12px;
      border-color:#eef2f8;
      vertical-align:middle;
      text-align:center;
    }

    .tabla-productos tbody tr{
      transition:background .16s ease;
    }

    .tabla-productos tbody tr:hover{
      background:#f9fbff;
    }

    .row-danger{
      background:rgba(214,40,57,.05);
    }

    .product-name{
      text-align:left !important;
    }

    .product-name strong{
      display:block;
      color:#162542;
      font-weight:800;
      margin-bottom:2px;
    }

    .product-name span{
      display:block;
      color:var(--jp-muted);
      font-size:.83rem;
    }

    .price-buy{
      color:var(--jp-muted);
      font-weight:700;
      white-space:nowrap;
    }

    .price-sell{
      color:var(--jp-success);
      font-weight:900;
      white-space:nowrap;
    }

    .stock-number{
      font-weight:900;
      color:var(--jp-primary);
      font-size:1rem;
    }

    .stock-low{
      color:var(--jp-danger);
    }

    .badge-estado{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      border-radius:999px;
      padding:7px 12px;
      font-size:.74rem;
      font-weight:800;
      letter-spacing:.2px;
      white-space:nowrap;
    }

    .badge-ok{
      background:rgba(21,148,71,.12);
      color:var(--jp-success);
    }

    .badge-low{
      background:rgba(214,40,57,.12);
      color:var(--jp-danger);
    }

    .action-group{
      display:flex;
      justify-content:center;
      gap:8px;
      flex-wrap:wrap;
    }

    .btn-action{
      border:none;
      border-radius:12px;
      padding:9px 12px;
      font-weight:700;
      font-size:.84rem;
      text-decoration:none;
      transition:.18s ease;
      display:inline-flex;
      align-items:center;
      gap:6px;
    }

    .btn-edit{
      background:linear-gradient(135deg, #234eb3, #1d3f92);
      color:#fff;
    }

    .btn-edit:hover{
      color:#fff;
      transform:translateY(-1px);
      filter:brightness(1.03);
    }

    .btn-delete{
      background:#fff1f2;
      color:var(--jp-danger);
      border:1px solid rgba(214,40,57,.14);
    }

    .btn-delete:hover{
      background:#ffe4e8;
      color:#b61f2f;
    }

    .empty-state{
      padding:34px 18px;
      text-align:center;
      color:var(--jp-muted);
    }

    .footer{
      margin-top:34px;
      background:linear-gradient(135deg, #dbe5ff, #c7d6ff);
      color:#30415f;
      text-align:center;
      padding:18px 12px;
      font-weight:600;
      border-top:1px solid rgba(34,58,115,.08);
    }

    @media (max-width: 1199px){
      .stats-grid{
        grid-template-columns:repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 767px){
      .header-inner{
        padding:22px 0 20px;
      }

      .brand-wrap{
        flex-direction:column;
        gap:12px;
      }

      .brand-logo{
        width:76px;
        height:76px;
      }

      .page-wrap{
        padding:20px 0 26px;
      }

      .hero-top,
      .hero-body{
        padding:18px 16px;
      }

      .hero-actions{
        width:100%;
      }

      .hero-actions .btn-header{
        flex:1 1 100%;
        justify-content:center;
      }

      .stats-grid{
        grid-template-columns:1fr;
        gap:12px;
      }

      .summary-card{
        min-height:auto;
      }

      .toolbar{
        grid-template-columns:1fr;
      }

      .table-card{
        border-radius:20px;
      }

      .table-card-header{
        padding:14px 14px;
      }

      .tabla-productos thead th,
      .tabla-productos tbody td{
        padding:12px 10px;
        font-size:.88rem;
      }

      .action-group{
        flex-direction:column;
      }

      .btn-action{
        justify-content:center;
      }
    }
  </style>
</head>
<body>
  <%
    const totalProductos = Number(resumen?.totalProductos || 0);
    const stockBajo = Number(resumen?.stockBajo || 0);
    const stockTotal = Number(resumen?.stockTotal || 0);

    const money = (n) => Number(n || 0).toFixed(2);
  %>

  <header class="main-header">
    <div class="container header-inner">
      <div class="brand-wrap">
        <img src="/images/logo-jp.png" alt="Logo JP" class="brand-logo">
        <div class="brand-text">
          <h1>JP Entrenamiento Personalizado</h1>
          <p>Panel de productos, stock, precios y control rápido del gimnasio</p>
        </div>
      </div>
    </div>
  </header>

  <main class="container page-wrap contenido">
    <section class="hero-card">
      <div class="hero-top">
        <div class="hero-head">
          <div>
            <h2 class="hero-title">📦 Gestión de productos</h2>
            <p class="hero-subtitle">
              Aquí el dueño del gimnasio puede ver todos los productos cargados,
              controlar el stock, revisar precios y detectar rápidamente qué necesita reponer.
            </p>
          </div>

          <div class="hero-actions">
            <a href="/" class="btn-header btn-header-back">← Volver</a>
            <a href="/productos/nuevo" class="btn-header btn-header-add">➕ Nuevo Producto</a>
          </div>
        </div>
      </div>

      <div class="hero-body">
        <div class="stats-grid">
          <div class="summary-card card-primary">
            <div class="summary-top">
              <p class="summary-label">Total de productos</p>
              <div class="summary-icon">📦</div>
            </div>
            <h3 class="summary-value"><%= totalProductos %></h3>
            <p class="summary-note">Cantidad de productos actualmente registrados.</p>
          </div>

          <div class="summary-card card-danger">
            <div class="summary-top">
              <p class="summary-label">Stock bajo</p>
              <div class="summary-icon">⚠️</div>
            </div>
            <h3 class="summary-value"><%= stockBajo %></h3>
            <p class="summary-note">Productos que están en el mínimo o por debajo.</p>
          </div>

          <div class="summary-card card-info">
            <div class="summary-top">
              <p class="summary-label">Unidades totales</p>
              <div class="summary-icon">🏷️</div>
            </div>
            <h3 class="summary-value"><%= stockTotal %></h3>
            <p class="summary-note">Suma total de unidades disponibles en stock.</p>
          </div>

          <div class="summary-card card-success">
            <div class="summary-top">
              <p class="summary-label">Estado del módulo</p>
              <div class="summary-icon">✅</div>
            </div>
            <h3 class="summary-value">Activo</h3>
            <p class="summary-note">Lista preparada para vender, editar y reponer rápido.</p>
          </div>
        </div>

        <div class="toolbar">
          <div class="toolbar-card">
            <h3 class="toolbar-title">Control de inventario</h3>
            <p class="toolbar-subtitle">Busca cualquier producto por nombre o categoría.</p>
          </div>

          <div class="search-wrap">
            <span class="search-icon">🔎</span>
            <input
              type="text"
              id="buscadorProductos"
              class="search-input"
              placeholder="Buscar producto por nombre o categoría..."
              autocomplete="off"
            >
          </div>
        </div>

        <div class="table-card">
          <div class="table-card-header">
            <div>
              <h3>Listado general de productos</h3>
              <p>Vista rápida para administrar precios, stock y reposición</p>
            </div>
          </div>

          <div class="table-responsive">
            <table class="table tabla-productos table-hover bg-white" id="tablaProductos">
              <thead>
                <tr>
                  <th>Producto</th>
                  <th>Categoría</th>
                  <th>Compra</th>
                  <th>Venta</th>
                  <th>Stock</th>
                  <th>Mínimo</th>
                  <th>Estado</th>
                  <th>Acciones</th>
                </tr>
              </thead>

              <tbody>
                <% if (productos && productos.length > 0) { %>
                  <% productos.forEach(producto => { %>
                    <tr class="<%= producto.stock <= producto.stockMinimo ? 'row-danger' : '' %>">
                      <td class="product-name">
                        <strong><%= producto.nombre %></strong>
                        <span><%= producto.descripcion ? producto.descripcion : 'Producto del gimnasio' %></span>
                      </td>

                      <td>
                        <span class="badge text-bg-light border px-3 py-2">
                          <%= producto.categoria || 'General' %>
                        </span>
                      </td>

                      <td class="price-buy">
                        $<%= money(producto.precioCompra) %>
                      </td>

                      <td class="price-sell">
                        $<%= money(producto.precioVenta) %>
                      </td>

                      <td class="stock-number <%= producto.stock <= producto.stockMinimo ? 'stock-low' : '' %>">
                        <%= Number(producto.stock || 0) %>
                      </td>

                      <td>
                        <strong><%= Number(producto.stockMinimo || 0) %></strong>
                      </td>

                      <td>
                        <% if (Number(producto.stock || 0) <= Number(producto.stockMinimo || 0)) { %>
                          <span class="badge-estado badge-low">Stock Bajo</span>
                        <% } else { %>
                          <span class="badge-estado badge-ok">OK</span>
                        <% } %>
                      </td>

                      <td>
                        <div class="action-group">
                          <a href="/productos/editar/<%= producto._id %>" class="btn-action btn-edit">✏️ Editar</a>

                          <form action="/productos/eliminar/<%= producto._id %>" method="POST" class="d-inline">
                            <button
                              type="submit"
                              class="btn-action btn-delete"
                              onclick="return confirm('¿Eliminar producto?')"
                            >
                              🗑 Eliminar
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="8" class="empty-state">
                      No hay productos cargados todavía.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    Todos los derechos reservados - Levi Prog.
  </footer>

  <script>
    const buscadorProductos = document.getElementById('buscadorProductos');
    const filasProductos = document.querySelectorAll('#tablaProductos tbody tr');

    if (buscadorProductos) {
      buscadorProductos.addEventListener('input', () => {
        const texto = buscadorProductos.value.toLowerCase().trim();

        filasProductos.forEach(fila => {
          const textoFila = fila.textContent.toLowerCase();
          fila.style.display = textoFila.includes(texto) ? '' : 'none';
        });
      });
    }
  </script>
</body>
</html>