<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Gastos | JP</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    :root{
      --jp-primary:#223a73;
      --jp-primary-2:#2f4f9a;
      --jp-bg:#f4f7fc;
      --jp-text:#1f2937;
      --jp-muted:#6b7280;
      --jp-danger:#d62839;
      --jp-border:#d9e2f1;
      --jp-shadow:0 10px 30px rgba(27,47,95,.10);
      --jp-success:#1f9d55;
      --jp-soft:#eef4ff;
    }
    *{ box-sizing:border-box; }
    body{
      margin:0; min-height:100vh; font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background:linear-gradient(180deg,#f8fbff 0%, var(--jp-bg) 100%);
      color:var(--jp-text); position:relative;
    }
    body::before{
      content:""; position:fixed; inset:0; background-image:url('/images/logo-jp.png');
      background-repeat:repeat; background-size:110px; opacity:.03; pointer-events:none;
    }
    .topbar,.wrap,.footer{ position:relative; z-index:1; }
    .topbar{
      background:linear-gradient(135deg, var(--jp-primary), var(--jp-primary-2));
      color:#fff; padding:20px 0; box-shadow:0 10px 24px rgba(34,58,115,.18);
    }
    .brand{ display:flex; align-items:center; justify-content:center; gap:14px; flex-wrap:wrap; text-align:center; }
    .brand img{ width:72px; height:72px; border-radius:50%; background:#fff; padding:4px; }
    .brand h1{ margin:0; font-size:clamp(1.4rem,3vw,2rem); font-weight:800; }
    .brand p{ margin:4px 0 0; opacity:.9; }

    .page{ max-width:1120px; margin:28px auto; padding:0 16px; }
    .panel{
      background:rgba(255,255,255,.94); border:1px solid var(--jp-border);
      border-radius:28px; box-shadow:var(--jp-shadow); overflow:hidden;
    }
    .head{
      padding:24px 28px; border-bottom:1px solid var(--jp-border);
      display:flex; justify-content:space-between; align-items:flex-start; gap:16px; flex-wrap:wrap;
    }
    .head h2{ margin:0; color:var(--jp-primary); font-size:clamp(1.4rem,2.4vw,2rem); font-weight:800; }
    .head p{ margin:6px 0 0; color:var(--jp-muted); }
    .actions{ display:flex; gap:10px; flex-wrap:wrap; }

    .btn-soft,.btn-main,.btn-filter,.btn-clear{
      border:none; border-radius:999px; padding:12px 18px; font-weight:700; text-decoration:none;
      display:inline-flex; align-items:center; justify-content:center; gap:8px;
    }
    .btn-soft{ background:#fff; color:var(--jp-primary); box-shadow:0 8px 18px rgba(34,58,115,.10); }
    .btn-main{ background:linear-gradient(135deg, var(--jp-danger), #ef4c5d); color:#fff; box-shadow:0 10px 20px rgba(214,40,57,.18); }
    .btn-filter{ background:linear-gradient(135deg, var(--jp-primary), var(--jp-primary-2)); color:#fff; box-shadow:0 10px 20px rgba(34,58,115,.18); }
    .btn-clear{ background:#eef2f9; color:var(--jp-primary); }

    .body{ padding:24px 28px 28px; }
    .stats{
      display:grid; grid-template-columns:repeat(4, minmax(0,1fr)); gap:14px; margin-bottom:22px;
    }
    .stat{
      background:#f8fbff; border:1px solid var(--jp-border); border-radius:18px; padding:16px;
    }
    .stat span{ display:block; font-size:.84rem; color:var(--jp-muted); font-weight:700; margin-bottom:8px; }
    .stat strong{ font-size:1.35rem; font-weight:800; color:var(--jp-primary); }
    .stat .danger{ color:var(--jp-danger); }
    .stat .success{ color:var(--jp-success); }

    .form-box, .filter-box{
      background:#fff; border:1px solid var(--jp-border); border-radius:20px; padding:20px; margin-bottom:20px;
    }

    form{ display:grid; gap:18px; }

    .grid-5{
      display:grid; grid-template-columns:2fr 1fr 1.2fr 1.2fr 1.2fr; gap:16px;
    }

    .grid-filter{
      display:grid; grid-template-columns:1.2fr 1.2fr auto; gap:16px; align-items:end;
    }

    .field{ display:flex; flex-direction:column; gap:7px; }
    .field label{ font-size:.92rem; font-weight:700; color:#43506a; }
    .field input,.field select{
      width:100%; border:1px solid #c8d3e4; border-radius:14px; padding:14px 15px;
      font-size:1rem; background:#fff; color:var(--jp-text); outline:none;
    }
    .field input:focus,.field select:focus{
      border-color:#7ea7ff; box-shadow:0 0 0 4px rgba(126,167,255,.14);
    }

    .filter-actions{
      display:flex; gap:10px; flex-wrap:wrap;
    }

    .filter-info{
      margin-top:12px;
      padding:12px 14px;
      border-radius:14px;
      background:var(--jp-soft);
      border:1px solid var(--jp-border);
      color:var(--jp-primary);
      font-weight:600;
    }

    .search{ margin:0 0 18px; }
    .search input{
      width:100%; border:1px solid #c8d3e4; border-radius:16px; padding:14px 16px; font-size:1rem;
    }

    .table-wrap{
      background:#fff; border:1px solid var(--jp-border); border-radius:22px; overflow:hidden;
    }
    table{ width:100%; border-collapse:collapse; }
    thead th{
      background:#18284b; color:#fff; padding:14px 12px; font-size:.86rem; text-transform:uppercase;
    }
    tbody td{
      padding:14px 12px; border-top:1px solid #edf1f7; text-align:center;
    }
    tbody tr:hover{ background:#f8fbff; }

    .desc-cell{ text-align:left; font-weight:700; color:#223a73; }
    .amount-cell{ color:var(--jp-danger); font-weight:800; }
    .empty{ text-align:center; padding:24px; color:var(--jp-muted); }

    .footer{
      text-align:center; padding:18px 12px 28px; color:#53627f; font-weight:600;
    }

    @media (max-width: 950px){
      .stats{ grid-template-columns:repeat(2, minmax(0,1fr)); }
      .grid-5{ grid-template-columns:1fr 1fr; }
      .grid-filter{ grid-template-columns:1fr 1fr; }
    }
    @media (max-width: 600px){
      .head,.body{ padding:18px; }
      .stats{ grid-template-columns:1fr; }
      .grid-5{ grid-template-columns:1fr; }
      .grid-filter{ grid-template-columns:1fr; }
      .actions{ flex-direction:column; }
      .filter-actions{ flex-direction:column; }
      .btn-soft,.btn-main,.btn-filter,.btn-clear{ width:100%; }
    }
  </style>
</head>
<body>
  <%
    const money = (n) => Number(n || 0).toFixed(2);
    const gastosLista = Array.isArray(gastos) ? gastos : [];
    const totalGastadoHoy = Number(totalHoy || 0);
    const totalPeriodo = Number(totalFiltrado || 0);
    const fechaDesde = typeof desde !== 'undefined' ? desde : '';
    const fechaHasta = typeof hasta !== 'undefined' ? hasta : '';
    const hayFiltro = !!(fechaDesde || fechaHasta);
    const promedioPeriodo = gastosLista.length > 0 ? (totalPeriodo / gastosLista.length) : 0;
    const fechaHoyInput = new Intl.DateTimeFormat('en-CA', {
      timeZone: 'America/Argentina/Buenos_Aires',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit'
    }).format(new Date());

    const formatFechaLocal = (fechaLocal, fecha) => {
      if (fechaLocal && /^\d{4}-\d{2}-\d{2}$/.test(String(fechaLocal))) {
        const [year, month, day] = String(fechaLocal).split('-');
        return `${day}/${month}/${year}`;
      }

      if (!fecha) return '-';

      return new Intl.DateTimeFormat('es-AR', {
        timeZone: 'America/Argentina/Buenos_Aires',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        hour12: false
      }).format(new Date(fecha));
    };
  %>

  <header class="topbar">
    <div class="container brand">
      <img src="/images/logo-jp.png" alt="Logo JP">
      <div>
        <h1>JP Entrenamiento Personalizado</h1>
        <p>Control de gastos</p>
      </div>
    </div>
  </header>

  <main class="page wrap">
    <section class="panel">
      <div class="head">
        <div>
          <h2>💸 Gastos</h2>
          <p>Registra y controla los egresos del gimnasio.</p>
        </div>

        <div class="actions">
          <a href="/" class="btn-soft">← Volver</a>
          <a href="/reportes" class="btn-soft">📊 Ver Reportes</a>
        </div>
      </div>

      <div class="body">
        <div class="stats">
          <div class="stat">
            <span>Total gastado hoy</span>
            <strong class="danger">$<%= money(totalGastadoHoy) %></strong>
          </div>
          <div class="stat">
            <span><%= hayFiltro ? 'Gastos del período' : 'Gastos cargados' %></span>
            <strong><%= gastosLista.length %></strong>
          </div>
          <div class="stat">
            <span><%= hayFiltro ? 'Total del período' : 'Promedio' %></span>
            <strong class="<%= hayFiltro ? 'danger' : '' %>">
              $<%= hayFiltro ? money(totalPeriodo) : money(promedioPeriodo) %>
            </strong>
          </div>
          <div class="stat">
            <span><%= hayFiltro ? 'Promedio del período' : 'Estado' %></span>
            <strong class="<%= hayFiltro ? 'success' : '' %>">
              <%= hayFiltro ? ('$' + money(promedioPeriodo)) : 'Activo' %>
            </strong>
          </div>
        </div>

        <div class="form-box">
          <form action="/gastos/nuevo" method="POST">
            <div class="grid-5">
              <div class="field">
                <label for="descripcion">Descripción</label>
                <input type="text" id="descripcion" name="descripcion" placeholder="Ej: Alquiler, luz, limpieza..." required>
              </div>

              <div class="field">
                <label for="monto">Monto</label>
                <input type="number" step="0.01" id="monto" name="monto" placeholder="0.00" required>
              </div>

              <div class="field">
                <label for="categoria">Categoría</label>
                <select name="categoria" id="categoria">
                  <option>Alquiler</option>
                  <option>Servicios</option>
                  <option>Mercadería</option>
                  <option>Mantenimiento</option>
                  <option>Limpieza</option>
                  <option>Publicidad</option>
                  <option>Sueldos</option>
                  <option>Otros</option>
                </select>
              </div>

              <div class="field">
                <label for="metodoPago">Pago</label>
                <select name="metodoPago" id="metodoPago">
                  <option>Efectivo</option>
                  <option>Transferencia</option>
                  <option>Mercado Pago</option>
                  <option>Otro</option>
                </select>
              </div>

              <div class="field">
                <label for="fecha">Fecha</label>
                <input
                  type="date"
                  id="fecha"
                  name="fecha"
                  required
                  value="<%= fechaHoyInput %>"
                >
              </div>
            </div>

            <div class="field">
              <label for="observacion">Observación</label>
              <input type="text" id="observacion" name="observacion" placeholder="Opcional">
            </div>

            <div>
              <button type="submit" class="btn-main">✅ Guardar Gasto</button>
            </div>
          </form>
        </div>

        <div class="filter-box">
          <form action="/gastos" method="GET">
            <div class="grid-filter">
              <div class="field">
                <label for="desde">Desde</label>
                <input type="date" id="desde" name="desde" value="<%= fechaDesde %>">
              </div>

              <div class="field">
                <label for="hasta">Hasta</label>
                <input type="date" id="hasta" name="hasta" value="<%= fechaHasta %>">
              </div>

              <div class="filter-actions">
                <button type="submit" class="btn-filter">🔎 Filtrar</button>
                <a href="/gastos" class="btn-clear">Limpiar</a>
              </div>
            </div>

            <div class="filter-info">
              <% if (hayFiltro) { %>
                Mostrando gastos del período
                <strong><%= fechaDesde ? formatFechaLocal(fechaDesde) : 'el inicio' %></strong>
                al
                <strong><%= fechaHasta ? formatFechaLocal(fechaHasta) : 'día actual' %></strong>.
                Total filtrado: <strong>$<%= money(totalPeriodo) %></strong>
              <% } else { %>
                Sin filtro aplicado. Se muestran los gastos más recientes.
              <% } %>
            </div>
          </form>
        </div>

        <div class="search">
          <input type="text" id="buscadorGastos" placeholder="Buscar en el historial de gastos...">
        </div>

        <div class="table-wrap">
          <table id="tablaGastos">
            <thead>
              <tr>
                <th>Fecha</th>
                <th>Descripción</th>
                <th>Categoría</th>
                <th>Monto</th>
                <th>Pago</th>
                <th>Obs.</th>
              </tr>
            </thead>
            <tbody>
              <% if (gastosLista.length > 0) { %>
                <% gastosLista.forEach(gasto => { %>
                  <tr>
                    <td><%= formatFechaLocal(gasto.fechaLocal, gasto.fecha) %></td>
                    <td class="desc-cell"><%= gasto.descripcion %></td>
                    <td><%= gasto.categoria || 'Otros' %></td>
                    <td class="amount-cell">$<%= money(gasto.monto) %></td>
                    <td><%= gasto.metodoPago || '-' %></td>
                    <td><%= gasto.observacion && gasto.observacion.trim() ? gasto.observacion : '-' %></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="empty">
                    No hay gastos registrados para el período seleccionado.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    Todos los derechos reservados - M.L DESARROLLOS WEB.
  </footer>

  <script>
    const buscadorGastos = document.getElementById('buscadorGastos');
    const filasGastos = document.querySelectorAll('#tablaGastos tbody tr');

    if (buscadorGastos) {
      buscadorGastos.addEventListener('input', () => {
        const texto = buscadorGastos.value.toLowerCase().trim();

        filasGastos.forEach(fila => {
          const contenido = fila.textContent.toLowerCase();
          fila.style.display = contenido.includes(texto) ? '' : 'none';
        });
      });
    }
  </script>
</body>
</html>