<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Editar Producto | JP</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    :root{
      --jp-primary:#223a73;
      --jp-primary-2:#2f4f9a;
      --jp-bg:#f4f7fc;
      --jp-card:#ffffff;
      --jp-text:#1f2937;
      --jp-muted:#6b7280;
      --jp-success:#159447;
      --jp-danger:#d62839;
      --jp-border:#d9e2f1;
      --jp-shadow:0 10px 30px rgba(27,47,95,.10);
      --radius:22px;
    }

    *{ box-sizing:border-box; }

    body{
      margin:0;
      min-height:100vh;
      font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      color:var(--jp-text);
      background:linear-gradient(180deg, #f8fbff 0%, var(--jp-bg) 100%);
      position:relative;
    }

    body::before{
      content:"";
      position:fixed;
      inset:0;
      background-image:url('/images/logo-jp.png');
      background-repeat:repeat;
      background-size:110px;
      opacity:.03;
      pointer-events:none;
    }

    .wrap,.footer,.topbar{ position:relative; z-index:1; }

    .topbar{
      background:linear-gradient(135deg, var(--jp-primary), var(--jp-primary-2));
      color:#fff;
      padding:20px 0;
      box-shadow:0 10px 24px rgba(34,58,115,.18);
    }

    .brand{
      display:flex;
      align-items:center;
      justify-content:center;
      gap:14px;
      flex-wrap:wrap;
      text-align:center;
    }

    .brand img{
      width:72px;
      height:72px;
      border-radius:50%;
      background:#fff;
      padding:4px;
    }

    .brand h1{
      margin:0;
      font-size:clamp(1.4rem,3vw,2rem);
      font-weight:800;
    }

    .brand p{
      margin:4px 0 0;
      opacity:.9;
    }

    .page{
      max-width:1100px;
      margin:28px auto;
      padding:0 16px;
    }

    .panel{
      background:rgba(255,255,255,.92);
      border:1px solid var(--jp-border);
      border-radius:28px;
      box-shadow:var(--jp-shadow);
      overflow:hidden;
      backdrop-filter:blur(8px);
    }

    .panel-head{
      padding:24px 28px;
      border-bottom:1px solid var(--jp-border);
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      gap:16px;
      flex-wrap:wrap;
    }

    .panel-head h2{
      margin:0;
      color:var(--jp-primary);
      font-size:clamp(1.4rem,2.4vw,2rem);
      font-weight:800;
    }

    .panel-head p{
      margin:6px 0 0;
      color:var(--jp-muted);
    }

    .actions{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
    }

    .btn-soft,
    .btn-main{
      border:none;
      border-radius:999px;
      padding:12px 18px;
      font-weight:700;
      text-decoration:none;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      transition:.18s ease;
    }

    .btn-soft{
      background:#fff;
      color:var(--jp-primary);
      box-shadow:0 8px 18px rgba(34,58,115,.10);
    }

    .btn-soft:hover{
      background:#eef3ff;
      color:var(--jp-primary);
    }

    .btn-main{
      background:linear-gradient(135deg, #234eb3, #1d3f92);
      color:#fff;
      box-shadow:0 10px 20px rgba(29,63,146,.18);
    }

    .btn-main:hover{
      color:#fff;
      transform:translateY(-1px);
    }

    .panel-body{
      padding:24px 28px 28px;
    }

    .stats{
      display:grid;
      grid-template-columns:repeat(3, minmax(0,1fr));
      gap:14px;
      margin-bottom:22px;
    }

    .stat{
      background:#f8fbff;
      border:1px solid var(--jp-border);
      border-radius:18px;
      padding:16px;
    }

    .stat span{
      display:block;
      font-size:.84rem;
      color:var(--jp-muted);
      font-weight:700;
      margin-bottom:8px;
    }

    .stat strong{
      font-size:1.35rem;
      font-weight:800;
      color:var(--jp-primary);
    }

    .stat .danger{ color:var(--jp-danger); }
    .stat .success{ color:var(--jp-success); }

    form{
      display:grid;
      gap:18px;
    }

    .grid-2{
      display:grid;
      grid-template-columns:repeat(2, minmax(0,1fr));
      gap:16px;
    }

    .grid-4{
      display:grid;
      grid-template-columns:repeat(4, minmax(0,1fr));
      gap:16px;
    }

    .field{
      display:flex;
      flex-direction:column;
      gap:7px;
    }

    .field label{
      font-size:.92rem;
      font-weight:700;
      color:#43506a;
    }

    .field input,
    .field textarea{
      width:100%;
      border:1px solid #c8d3e4;
      border-radius:14px;
      padding:14px 15px;
      font-size:1rem;
      background:#fff;
      color:var(--jp-text);
      outline:none;
      transition:.15s ease;
    }

    .field textarea{
      min-height:120px;
      resize:vertical;
    }

    .field input:focus,
    .field textarea:focus{
      border-color:#7ea7ff;
      box-shadow:0 0 0 4px rgba(126,167,255,.14);
    }

    .bottom-actions{
      display:flex;
      gap:12px;
      flex-wrap:wrap;
      margin-top:6px;
    }

    .footer{
      text-align:center;
      padding:18px 12px 28px;
      color:#53627f;
      font-weight:600;
    }

    @media (max-width: 900px){
      .stats{ grid-template-columns:1fr; }
      .grid-2{ grid-template-columns:1fr; }
      .grid-4{ grid-template-columns:repeat(2, minmax(0,1fr)); }
    }

    @media (max-width: 600px){
      .panel-head, .panel-body{ padding:18px; }
      .grid-4{ grid-template-columns:1fr; }
      .actions, .bottom-actions{ flex-direction:column; }
      .btn-soft, .btn-main{ width:100%; }
    }
  </style>
</head>
<body>
  <%
    const stockActual = Number(producto?.stock || 0);
    const stockMinimo = Number(producto?.stockMinimo || 0);
    const precioCompra = Number(producto?.precioCompra || 0);
    const precioVenta = Number(producto?.precioVenta || 0);
    const margen = precioVenta - precioCompra;
    const stockBajo = stockActual <= stockMinimo;
  %>

  <header class="topbar">
    <div class="container brand">
      <img src="/images/logo-jp.png" alt="Logo JP">
      <div>
        <h1>JP Entrenamiento Personalizado</h1>
        <p>Edición de productos</p>
      </div>
    </div>
  </header>

  <main class="page wrap">
    <section class="panel">
      <div class="panel-head">
        <div>
          <h2>✏️ Editar producto</h2>
          <p>Actualiza el producto de forma rápida y clara.</p>
        </div>

        <div class="actions">
          <a href="/productos" class="btn-soft">← Volver</a>
          <a href="/ventas" class="btn-soft">💰 Ir a Ventas</a>
        </div>
      </div>

      <div class="panel-body">
        <div class="stats">
          <div class="stat">
            <span>Stock actual</span>
            <strong class="<%= stockBajo ? 'danger' : 'success' %>"><%= stockActual %></strong>
          </div>
          <div class="stat">
            <span>Stock mínimo</span>
            <strong><%= stockMinimo %></strong>
          </div>
          <div class="stat">
            <span>Margen estimado</span>
            <strong class="<%= margen >= 0 ? 'success' : 'danger' %>">$<%= margen.toFixed(2) %></strong>
          </div>
        </div>

        <form action="/productos/editar/<%= producto._id %>" method="POST">
          <div class="grid-2">
            <div class="field">
              <label for="nombre">Nombre del producto</label>
              <input type="text" id="nombre" name="nombre" value="<%= producto.nombre %>" required>
            </div>

            <div class="field">
              <label for="categoria">Categoría</label>
              <input type="text" id="categoria" name="categoria" value="<%= producto.categoria || '' %>">
            </div>
          </div>

          <div class="field">
            <label for="descripcion">Descripción</label>
            <textarea id="descripcion" name="descripcion"><%= producto.descripcion || '' %></textarea>
          </div>

          <div class="grid-4">
            <div class="field">
              <label for="precioCompra">Precio de compra</label>
              <input type="number" step="0.01" id="precioCompra" name="precioCompra" value="<%= precioCompra %>">
            </div>

            <div class="field">
              <label for="precioVenta">Precio de venta</label>
              <input type="number" step="0.01" id="precioVenta" name="precioVenta" value="<%= precioVenta %>" required>
            </div>

            <div class="field">
              <label for="stock">Stock actual</label>
              <input type="number" id="stock" name="stock" value="<%= stockActual %>" required>
            </div>

            <div class="field">
              <label for="stockMinimo">Stock mínimo</label>
              <input type="number" id="stockMinimo" name="stockMinimo" value="<%= stockMinimo %>">
            </div>
          </div>

          <div class="bottom-actions">
            <button type="submit" class="btn-main">✅ Guardar Cambios</button>
            <a href="/productos" class="btn-soft">📦 Volver al Listado</a>
          </div>
        </form>
      </div>
    </section>
  </main>

  <footer class="footer">
    Todos los derechos reservados - M.L DESARROLLOS WEB.
  </footer>
</body>
</html>