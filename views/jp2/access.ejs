<%- include('partials/head',{title:'Ingresar'}) %><div class="auth"><div class="card"><img src="/images/logo-jp.png" width="76" alt="JP"><h1>JP Entrenamiento</h1><p class="lead">Tu gimnasio, tu progreso.</p><% if(error){ %><div class="alert">DNI/usuario o contraseña incorrectos.</div><% } %><form action="/acceso" method="post"><label>Ingresar como</label><select name="tipo"><option value="alumno">Alumno</option><option value="profesor">Profesor</option></select><label>DNI (alumno) o usuario (profesor)</label><input name="usuario" autocomplete="username" required><label>Contraseña</label><input name="clave" type="password" autocomplete="current-password" required><p><button class="btn" style="width:100%">Ingresar</button></p></form><a href="/login">Acceso del dueño</a></div></div><%- include('partials/end') %>