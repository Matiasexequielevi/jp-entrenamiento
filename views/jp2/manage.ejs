<%- include('partials/head',{title:'Gestión del gimnasio'}) %><div class="shell"><%- include('partials/nav') %><main class="main"><div class="hero"><h1>⚙️ Centro de gestión</h1><p>Accesos de alumnos, profesores, novedades y horarios.</p></div><div class="grid"><section class="card"><h2>📱 Habilitar app del alumno</h2><form method="post" action="/gestion/acceso"><label>Alumno existente</label><select name="alumnoId"><% clientes.forEach(c=>{ %><option value="<%= c._id %>"><%= c.apellido %>, <%= c.nombre %> <%= c.dni||'' %></option><% }) %></select><label>DNI (7 a 9 números)</label><input name="dni" pattern="[0-9]{7,9}" required><label>Contraseña inicial (mínimo 6caracteres)</label><input type="password" name="clave" minlength="6" required><p class="muted">Se guarda cifrada. El alumno debe cambiarla al ingresar. Repetir este formulario restablece su acceso.</p><button class="btn">Habilitar / restablecer</button></form></section><section class="card"><h2>👨‍🏫 Nuevo profesor</h2><form method="post" action="/gestion/profesor"><label>Nombre</label><input name="nombre" required><label>Usuario</label><input name="usuario" required><label>Contraseña (mínimo 10 caracteres)</label><input name="clave" type="password" minlength="6" required><p><button class="btn">Crear profesor</button></p></form><h3>Profesores</h3><% profesores.forEach(p=>{ %><div class="exercise"><b><%= p.nombre %></b> · <%= p.usuario %> <span class="tag"><%= p.activo?'Activo':'Inactivo' %></span><% if(p.activo){ %><form method="post" action="/gestion/profesor/<%= p._id %>/desactivar"><button class="btn danger">Desactivar</button></form><% } %></div><% }) %></section><section class="card"><h2>📢 Publicar novedad</h2><form method="post" action="/gestion/novedad"><label>Título</label><input name="titulo" maxlength="140" required><label>Mensaje</label><textarea name="mensaje" maxlength="3000" required></textarea><label>Tipo</label><select name="tipo"><option value="info">Información</option><option value="alerta">Alerta</option></select><p><button class="btn">Publicar en la app</button></p></form><% novedades.forEach(n=>{ %><div class="exercise"><b><%= n.titulo %></b> · <%= n.activa?'Visible':'Oculta' %><p><%= n.mensaje %></p><% if(n.activa){ %><form method="post" action="/gestion/novedad/<%= n._id %>/eliminar"><button class="btn danger">Ocultar</button></form><% } %></div><% }) %></section><section class="card"><h2>🕒 Datos y horarios</h2><form method="post" action="/gestion/config"><label>Nombre del gimnasio</label><input name="nombre" value="<%= conf.nombre %>"><label>Dirección</label><input name="direccion" value="<%= conf.direccion %>"><label>Teléfono</label><input name="telefono" value="<%= conf.telefono %>"><label>Horarios</label><textarea name="horarios"><%= conf.horarios %></textarea><label>Días cerrados</label><input name="diasCerrados" value="<%= conf.diasCerrados %>"><label>Duración de cuota (días)</label><input type="number" min="1" max="365" name="duracionCuota" value="<%= conf.duracionCuota %>"><p><button class="btn">Guardar configuración</button></p></form></section></div></main></div><%- include('partials/end') %>