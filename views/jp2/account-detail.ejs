<%- include('partials/head',{title:'Cuenta de alumno'}) %><div class="shell"><%- include('partials/nav') %><main class="main"><h1>Cuenta de <%= c.nombre %> <%= c.apellido %></h1><div class="card"><p>Saldo pendiente</p><div class="stat">$<%= cuenta.total.toLocaleString('es-AR',{minimumFractionDigits:2}) %></div><a href="/cuentas" class="btn secondary">Volver a cuentas</a></div><div class="card table-wrap"><table><tr><th>Fecha</th><th>Movimiento</th><th>Importe</th><th>Operador</th></tr><% cuenta.movs.forEach(m=>{ %><tr><td><%= new Date(m.fecha).toLocaleString('es-AR') %></td><td><%= m.descripcion %></td><td><%= m.tipo==='cargo'?'+':'-' %>$<%= m.importe %></td><td><%= m.actor %></td></tr><% }) %></table></div></main></div><%- include('partials/end') %>