     MENSAJES EMERGENTES JP 2.0
===================================== -->

<style>

.jp-message-overlay {
  position: fixed;
  inset: 0;
  background: rgba(12, 25, 49, .72);
  z-index: 99999;

  display: none;
  align-items: center;
  justify-content: center;

  padding: 20px;
}

.jp-message-overlay.visible {
  display: flex;
}

.jp-message-box {
  width: 100%;
  max-width: 420px;
  max-height: 85vh;
  overflow-y: auto;

  background: white;
  border-radius: 24px;
  padding: 27px;

  text-align: center;
  box-shadow: 0 20px 70px rgba(0, 0, 0, .2);
}

.jp-message-icon {
  font-size: 43px;
  margin-bottom: 12px;
}

.jp-message-box h2 {
  font-size: 21px;
  margin: 0 0 12px;
  color: #173361;
}

.jp-message-box p {
  font-size: 14px;
  line-height: 1.7;
  color: #465a77;
  white-space: pre-line;
  overflow-wrap: anywhere;
}

.jp-message-box small {
  display: block;
  margin-top: 15px;
  color: #8491a4;
}

.jp-message-box button {
  width: 100%;
  margin-top: 23px;
  padding: 15px;

  background: #2857ae;
  border: none;
  border-radius: 13px;

  color: white;
  font-weight: 800;
  cursor: pointer;
}

</style>

<div
  class="jp-message-overlay"
  id="jpMessageOverlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="jpMessageTitle"
>

  <div class="jp-message-box">

    <div class="jp-message-icon">
      🔔
    </div>

    <h2 id="jpMessageTitle"></h2>

    <p id="jpMessageText"></p>

    <small id="jpMessageAuthor"></small>

    <button
      type="button"
      id="jpMessageConfirm"
    >
      ✓ Entendido
    </button>

  </div>

</div>

<script>
(function () {

  const overlay = document.getElementById('jpMessageOverlay');
  const titulo = document.getElementById('jpMessageTitle');
  const texto = document.getElementById('jpMessageText');
  const autor = document.getElementById('jpMessageAuthor');
  const boton = document.getElementById('jpMessageConfirm');

  if (!overlay || !boton) return;

  let pendientes = [];
  let actual = null;

  async function cargarMensajes() {

    try {

      const respuesta = await fetch('/mi-app/mensajes', {
        credentials: 'same-origin'
      });

      if (!respuesta.ok) return;

      const datos = await respuesta.json();

      if (!datos.ok) return;

      pendientes = datos.mensajes
        .filter(m => !m.leido)
        .reverse();

      mostrarSiguiente();

    } catch (error) {

      console.error('Error al consultar mensajes:', error);

    }

  }

  function mostrarSiguiente() {

    if (!pendientes.length) {

      overlay.classList.remove('visible');
      actual = null;

      return;
    }

    actual = pendientes.shift();

    titulo.textContent = actual.titulo;
    texto.textContent = actual.mensaje;
    autor.textContent = 'Mensaje de ' + actual.profesor;

    overlay.classList.add('visible');
    boton.focus();

  }

  boton.addEventListener('click', async function () {

    if (!actual) return;

    boton.disabled = true;
    boton.textContent = 'Guardando...';

    try {

      const respuesta = await fetch(
        '/mi-app/mensajes/' + encodeURIComponent(actual.id) + '/leido',
        {
          method: 'POST',
          credentials: 'same-origin'
        }
      );

      if (!respuesta.ok) {
        throw new Error('No se pudo confirmar el mensaje');
      }

      mostrarSiguiente();

    } catch (error) {

      alert('No pudimos confirmar la lectura. Intentá nuevamente.');

    } finally {

      boton.disabled = false;
      boton.textContent = '✓ Entendido';

    }

  });

  cargarMensajes();

})();
</script>
