<script>
(function () {
  'use strict';

  const paginas = document.querySelectorAll('.jp-page');
  const botonesNavegacion = document.querySelectorAll('.jp-nav-button');
  const botonesAbrir = document.querySelectorAll('[data-open-page]');
  const botonesDias = document.querySelectorAll('.jp-day-button');
  const panelesDias = document.querySelectorAll('.jp-day-content');

  /* ======================================
     NAVEGACIÓN PRINCIPAL
  ====================================== */

  function abrirPagina(nombre) {

    const paginaDestino = document.getElementById('jp-page-' + nombre);

    if (!paginaDestino) return;

    paginas.forEach(pagina => {
      pagina.classList.toggle('is-active', pagina === paginaDestino);
    });

    botonesNavegacion.forEach(boton => {
      const activo = boton.dataset.openPage === nombre;

      boton.classList.toggle('active', activo);

      if (activo) {
        boton.setAttribute('aria-current', 'page');
      } else {
        boton.removeAttribute('aria-current');
      }
    });

    window.scrollTo({
      top: 0,
      behavior: 'instant'
    });

  }

  botonesAbrir.forEach(boton => {

    boton.addEventListener('click', function () {
      abrirPagina(this.dataset.openPage);
    });

  });


  /* ======================================
     SELECCIÓN DEL DÍA
  ====================================== */

  function abrirDia(indice) {

    botonesDias.forEach(boton => {

      const activo = boton.dataset.day === String(indice);

      boton.classList.toggle('active', activo);
      boton.setAttribute('aria-selected', activo ? 'true' : 'false');

    });

    panelesDias.forEach(panel => {
      panel.classList.toggle(
        'active',
        panel.dataset.dayContent === String(indice)
      );
    });

  }

  botonesDias.forEach(boton => {

    boton.addEventListener('click', function () {
      abrirDia(this.dataset.day);
    });

  });


 /* ======================================
   PROGRESO DE ENTRENAMIENTO - MONGODB
====================================== */

const checks = document.querySelectorAll('.jp-exercise-check');

function actualizarProgreso() {
  document.querySelectorAll('.jp-day-content').forEach(panel => {
    const ejercicios = panel.querySelectorAll('.jp-exercise-check');
    const completados = panel.querySelectorAll(
      '.jp-exercise-check:checked'
    ).length;

    const total = ejercicios.length;
    const porcentaje = total
      ? Math.round(completados * 100 / total)
      : 0;

    const texto = panel.querySelector('.jp-progress-text');
    const barra = panel.querySelector('.jp-progress-fill');

    if (texto) texto.textContent = completados + ' / ' + total;
    if (barra) barra.style.width = porcentaje + '%';
  });
}

function actualizarTarjeta(check) {
  const tarjeta = check.closest('.jp-exercise');

  if (tarjeta) {
    tarjeta.classList.toggle('completed', check.checked);
  }
}

async function cargarProgreso() {
  try {
    const respuesta = await fetch('/mi-app/progreso', {
      credentials: 'same-origin'
    });

    if (!respuesta.ok) throw new Error('Error al cargar');

    const datos = await respuesta.json();

    if (!datos.ok) throw new Error('Respuesta inválida');

    checks.forEach(check => {
      const registro = datos.registros.find(
        r => r.rutina === check.dataset.routine
      );

      const indice = Number(check.dataset.index);

      check.checked = Boolean(
        registro &&
        registro.ejercicios[indice] &&
        registro.ejercicios[indice].completado
      );

      actualizarTarjeta(check);
    });

    actualizarProgreso();

  } catch (error) {
    console.error('Error al cargar el progreso:', error);
  }
}

checks.forEach(check => {
  check.addEventListener('change', async function () {
    const valorAnterior = !this.checked;

    actualizarTarjeta(this);
    actualizarProgreso();

    this.disabled = true;

    try {
      const respuesta = await fetch('/mi-app/progreso', {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          rutinaId: this.dataset.routine,
          ejercicioIndex: Number(this.dataset.index),
          completado: this.checked
        })
      });

      if (!respuesta.ok) {
        throw new Error('No se pudo guardar');
      }

      const datos = await respuesta.json();

      if (!datos.ok) {
        throw new Error('Error al guardar');
      }

    } catch (error) {
      this.checked = valorAnterior;
      actualizarTarjeta(this);
      actualizarProgreso();

      alert('No pudimos guardar tu progreso. Intentá nuevamente.');
    } finally {
      this.disabled = false;
    }
  });
});

cargarProgreso();

})();
</script>
