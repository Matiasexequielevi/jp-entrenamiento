<div class="jp-student-app">

  <!-- ======================================
       PANTALLA INICIO
  ======================================= -->

  <section class="jp-page is-active" id="jp-page-inicio">

    <header class="jp-app-header">

      <div class="jp-brand">
        <img
          src="/images/logo-jp.png"
          alt="JP Entrenamiento"
          class="jp-brand-logo"
        >

        <div>
          <strong>JP ENTRENAMIENTO</strong>
          <small>Bienvenido a la app de JP</small>
        </div>
      </div>

      <h1 class="jp-greeting">
        ¡Hola, <%= nombreAlumno %>! 💪
      </h1>

      <p class="jp-subtitle">
        Tu entrenamiento, siempre a mano.
      </p>

    </header>

    <div class="jp-section-heading">
      <h2>Mi gimnasio</h2>
      <p>Tu información más importante.</p>
    </div>

    <div class="jp-card">

      <span class="jp-status <%= diasRestantes === null ? 'warning' : cuotaVigente ? 'ok' : 'danger' %>">
        <%= diasRestantes === null
          ? 'Cuota sin fecha'
          : cuotaVigente
            ? '✓ Cuota al día'
            : '⚠ Cuota vencida'
        %>
      </span>

      <div class="jp-plan-name">
        <%= planAlumno %>
      </div>

      <div class="jp-info-line">
        <span>Próximo vencimiento</span>
        <strong><%= formatoFecha(fechaVencimiento) %></strong>
      </div>

      <p class="jp-alert-text">
        <% if (diasRestantes === null) { %>
          Consultá en recepción por tu próximo vencimiento.
        <% } else if (diasRestantes === 0) { %>
          Tu cuota vence hoy.
        <% } else if (diasRestantes > 0) { %>
          Faltan <%= diasRestantes %> días para el vencimiento.
        <% } else { %>
          Tu cuota venció hace <%= Math.abs(diasRestantes) %> días.
        <% } %>
      </p>

    </div>

    <button
      type="button"
      class="jp-main-action"
      data-open-page="rutina"
    >
      <span>
        <strong>🏋️ Ver mi entrenamiento</strong>
        <small>
          <%= rutinasOrdenadas.length %> días ·
          <%= totalEjercicios %> ejercicios asignados
        </small>
      </span>

      <span class="arrow">→</span>
    </button>

    <div class="jp-mini-grid">

      <div class="jp-mini-stat">
        <small>📅 Días de rutina</small>
        <strong><%= rutinasOrdenadas.length %></strong>
      </div>

      <div class="jp-mini-stat">
        <small>💳 Saldo de productos</small>
        <strong>$<%= formatoDinero(saldoCuenta) %></strong>
      </div>

    </div>

  </section>


  <!-- ======================================
       PANTALLA RUTINA
  ======================================= -->

  <section class="jp-page" id="jp-page-rutina">

    <div class="jp-section-heading" style="padding-top:26px">
      <h2>🏋️ Mi entrenamiento</h2>
      <p>Elegí un día y completá los ejercicios en orden.</p>
    </div>

    <% if (!rutinasOrdenadas.length) { %>

      <div class="jp-card jp-empty">
        <span class="jp-empty-icon">🏋️</span>
        Tu profesor todavía no te asignó una rutina.
      </div>

    <% } else { %>

      <div class="jp-days" role="tablist" aria-label="Días de entrenamiento">

        <% rutinasOrdenadas.forEach((rutina, indice) => { %>

          <button
            type="button"
            class="jp-day-button <%= indice === 0 ? 'active' : '' %>"
            data-day="<%= indice %>"
            role="tab"
            aria-selected="<%= indice === 0 ? 'true' : 'false' %>"
          >
            <%= rutina.dia %>
          </button>

        <% }) %>

      </div>

      <% rutinasOrdenadas.forEach((rutina, indice) => { %>

        <div
          class="jp-day-content <%= indice === 0 ? 'active' : '' %>"
          data-day-content="<%= indice %>"
        >

          <div class="jp-card">

            <h3 class="jp-workout-title">
              <%= rutina.titulo || rutina.dia %>
            </h3>

            <p class="jp-workout-count">
              <%= rutina.ejercicios.length %> ejercicios para realizar
            </p>

            <div class="jp-progress-row">
              <span>Progreso del entrenamiento</span>
              <span class="jp-progress-text">
                0 / <%= rutina.ejercicios.length %>
              </span>
            </div>

            <div class="jp-progress-track">
              <div class="jp-progress-fill"></div>
            </div>

            <% rutina.ejercicios.forEach((ejercicio, numero) => { %>

              <article class="jp-exercise">

                <div class="jp-exercise-header">

                  <span class="jp-exercise-number">
                    <%= numero + 1 %>
                  </span>

                  <h3 class="jp-exercise-name">
                    <%= ejercicio.nombre %>
                  </h3>

                </div>

                <div class="jp-metrics">

                  <% if (ejercicio.series) { %>
                    <div class="jp-metric">
                      <strong><%= ejercicio.series %></strong>
                      <small>Series</small>
                    </div>
                  <% } %>

                  <% if (ejercicio.repeticiones) { %>
                    <div class="jp-metric">
                      <strong><%= ejercicio.repeticiones %></strong>
                      <small>Repeticiones</small>
                    </div>
                  <% } %>

                  <% if (ejercicio.peso && ejercicio.peso !== '-') { %>
                    <div class="jp-metric">
                      <strong><%= ejercicio.peso %></strong>
                      <small>Peso</small>
                    </div>
                  <% } %>

                  <% if (ejercicio.descanso && ejercicio.descanso !== '-') { %>
                    <div class="jp-metric">
