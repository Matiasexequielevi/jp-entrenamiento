<%- include('partials/head', { title: 'Mi gimnasio' }) %>

<%
  const fechaActual = new Date();
  const fechaVencimiento = venc ? new Date(venc) : null;

  const diasRestantes = fechaVencimiento && !isNaN(fechaVencimiento.getTime())
    ? Math.ceil((fechaVencimiento.getTime() - fechaActual.getTime()) / 86400000)
    : null;

  const cuotaVigente = diasRestantes !== null && diasRestantes >= 0;

  const nombreAlumno = c.nombre || 'Alumno';
  const apellidoAlumno = c.apellido || '';
  const planAlumno = c.plan || 'Sin plan';

  const listaRutinas = Array.isArray(rutinas) ? rutinas : [];
  const listaNovedades = Array.isArray(novedades) ? novedades : [];

  const cuentaAlumno = cuenta || { total: 0, movs: [] };
  const movimientos = Array.isArray(cuentaAlumno.movs) ? cuentaAlumno.movs : [];

  const configuracion = conf || {};

  const ordenDias = [
    'Lunes',
    'Martes',
    'Miércoles',
    'Jueves',
    'Viernes',
    'Sábado',
    'Domingo'
  ];

  const rutinasOrdenadas = [...listaRutinas].sort(
    (a, b) => ordenDias.indexOf(a.dia) - ordenDias.indexOf(b.dia)
  );

  const totalEjercicios = rutinasOrdenadas.reduce(
    (total, rutina) => total + (Array.isArray(rutina.ejercicios) ? rutina.ejercicios.length : 0),
    0
  );

  const saldoCuenta = Number(cuentaAlumno.total || 0);

  const formatoDinero = valor =>
    Number(valor || 0).toLocaleString('es-AR', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    });

  const formatoFecha = valor => {
    if (!valor) return 'Sin fecha';
    const fecha = new Date(valor);
    if (isNaN(fecha.getTime())) return 'Sin fecha';
    return fecha.toLocaleDateString('es-AR', { timeZone: 'UTC' });
  };
%>

<style>
  /* ==========================================
     JP ENTRENAMIENTO 2.0 - APP ALUMNOS
     Estilos aislados de la vista administrativa
  ========================================== */

