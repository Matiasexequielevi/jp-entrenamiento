  data-exercise="<%= ejercicio._id || numero %>"
  data-index="<%= numero %>"
>

                  <span>Marcar como realizado</span>

                </label>

              </article>

            <% }) %>

          </div>

        </div>

      <% }) %>

      <p class="jp-small-note">
        Tu progreso se guarda automaticamente en tu cuenta.
        El profesor puede actualizar tu rutina cuando sea necesario.
      </p>

    <% } %>

  </section>


  <!-- ======================================
       PANTALLA CUENTA
  ======================================= -->

