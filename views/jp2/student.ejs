    </div>

    <div class="jp-card">

      <h3>🕒 Horarios del gimnasio</h3>

      <div class="jp-schedule">
        <%= configuracion.horarios || 'Consultar horarios en recepción.' %>
      </div>

      <% if (configuracion.diasCerrados) { %>
        <div class="jp-info-line">
          <span>Días cerrados</span>
