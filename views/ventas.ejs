<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Ventas | JP</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    :root{
      --jp-primary:#223a73;
      --jp-primary-2:#2f4f9a;
      --jp-bg:#f4f7fc;
      --jp-text:#1f2937;
      --jp-muted:#6b7280;
      --jp-success:#159447;
      --jp-border:#d9e2f1;
      --jp-shadow:0 10px 30px rgba(27,47,95,.10);
    }
    *{ box-sizing:border-box; }
    body{
      margin:0; min-height:100vh; font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background:linear-gradient(180deg,#f8fbff 0%, var(--jp-bg) 100%);
      color:var(--jp-text); position:relative;
    }
    body::before{
      content:""; position:fixed; inset:0; background-image:url('/images/logo-jp.png');
      background-repeat:repeat; background-size:110px; opacity:.03; pointer-events:none;
    }
    .topbar,.wrap,.footer{ position:relative; z-index:1; }
    .topbar{
      background:linear-gradient(135deg, var(--jp-primary), var(--jp-primary-2));
      color:#fff; padding:20px 0; box-shadow:0 10px 24px rgba(34,58,115,.18);
    }
    .brand{ display:flex; align-items:center; justify-content:center; gap:14px; flex-wrap:wrap; text-align:center; }
    .brand img{ width:72px; height:72px; border-radius:50%; background:#fff; padding:4px; }
    .brand h1{ margin:0; font-size:clamp(1.4rem,3vw,2rem); font-weight:800; }
    .brand p{ margin:4px 0 0; opacity:.9; }

    .page{ max-width:1120px; margin:28px auto; padding:0 16px; }
    .panel{
      background:rgba(255,255,255,.94); border:1px solid var(--jp-border);
      border-radius:28px; box-shadow:var(--jp-shadow); overflow:hidden;
    }
    .head{
      padding:24px 28px; border-bottom:1px solid var(--jp-border);
      display:flex; justify-content:space-between; align-items:flex-start; gap:16px; flex-wrap:wrap;
    }
    .head h2{ margin:0; color:var(--jp-primary); font-size:clamp(1.4rem,2.4vw,2rem); font-weight:800; }
    .head p{ margin:6px 0 0; color:var(--jp-muted); }
    .actions{ display:flex; gap:10px; flex-wrap:wrap; }

    .btn-soft,.btn-main{
      border:none; border-radius:999px; padding:12px 18px; font-weight:700; text-decoration:none;
      display:inline-flex; align-items:center; justify-content:center; gap:8px;
    }
    .btn-soft{ background:#fff; color:var(--jp-primary); box-shadow:0 8px 18px rgba(34,58,115,.10); }
    .btn-main{ background:linear-gradient(135deg, var(--jp-success), #20b45a); color:#fff; box-shadow:0 10px 20px rgba(21,148,71,.18); }

    .body{ padding:24px 28px 28px; }
    .stats{
      display:grid; grid-template-columns:repeat(4, minmax(0,1fr)); gap:14px; margin-bottom:22px;
    }
    .stat{
      background:#f8fbff; border:1px solid var(--jp-border); border-radius:18px; padding:16px;
    }
    .stat span{ display:block; font-size:.84rem; color:var(--jp-muted); font-weight:700; margin-bottom:8px; }
    .stat strong{ font-size:1.35rem; font-weight:800; color:var(--jp-primary); }
    .stat .success{ color:var(--jp-success); }

    .sale-box{
      background:#fff; border:1px solid var(--jp-border); border-radius:20px; padding:20px; margin-bottom:20px;
    }

    form{ display:grid; gap:18px; }

    .grid-4{
      display:grid; grid-template-columns:2.2fr 1fr 1.3fr 1.5fr; gap:16px;
    }

    .field{ display:flex; flex-direction:column; gap:7px; }
    .field label{ font-size:.92rem; font-weight:700; color:#43506a; }
    .field input,.field select{
      width:100%; border:1px solid #c8d3e4; border-radius:14px; padding:14px 15px;
      font-size:1rem; background:#fff; color:var(--jp-text); outline:none;
    }
    .field input:focus,.field select:focus{
      border-color:#7ea7ff; box-shadow:0 0 0 4px rgba(126,167,255,.14);
    }

    .search{
      margin:0 0 18px;
    }
    .search input{
      width:100%; border:1px solid #c8d3e4; border-radius:16px; padding:14px 16px;
      font-size:1rem;
    }

    .table-wrap{
      background:#fff; border:1px solid var(--jp-border); border-radius:22px; overflow:hidden;
    }
    table{ width:100%; border-collapse:collapse; }
    thead th{
      background:#18284b; color:#fff; padding:14px 12px; font-size:.86rem; text-transform:uppercase;
    }
    tbody td{
      padding:14px 12px; border-top:1px solid #edf1f7; text-align:center;
    }
    tbody tr:hover{ background:#f8fbff; }

    .product-cell{ text-align:left; font-weight:700; color:#223a73; }
    .total-cell{ color:var(--jp-success); font-weight:800; }
    .empty{ text-align:center; padding:24px; color:var(--jp-muted); }

    .footer{
      text-align:center; padding:18px 12px 28px; color:#53627f; font-weight:600;
    }

    @media (max-width: 950px){
      .stats{ grid-template-columns:repeat(2, minmax(0,1fr)); }
      .grid-4{ grid-template-columns:1fr 1fr; }
    }
    @media (max-width: 600px){
      .head,.body{ padding:18px; }
      .stats{ grid-template-columns:1fr; }
      .grid-4{ grid-template-columns:1fr; }
      .actions{ flex-direction:column; }
      .btn-soft,.btn-main{ width:100%; }
    }
  </style>
</head>
<body>
  <%
    const money = (n) => Number(n || 0).toFixed(2);
    const ventasLista = Array.isArray(ventas) ? ventas : [];
    const productosLista = Array.isArray(productos) ? productos : [];
    const totalVendidoHoy = Number(totalHoy || 0);
  %>

  <header class="topbar">
    <div class="container brand">
      <img src="/images/logo-jp.png" alt="Logo JP">
      <div>
        <h1>JP Entrenamiento Personalizado</h1>
        <p>Ventas rápidas</p>
      </div>
    </div>
  </header>

  <main class="page wrap">
    <section class="panel">
      <div class="head">
        <div>
          <h2>💰 Venta rápida</h2>
          <p>Registra ventas de forma simple y rápida.</p>
        </div>

        <div class="actions">
          <a href="/" class="btn-soft">← Volver</a>
          <a href="/productos" class="btn-soft">📦 Productos</a>
        </div>
      </div>

      <div class="body">
        <div class="stats">
          <div class="stat">
            <span>Total vendido hoy</span>
            <strong class="success">$<%= money(totalVendidoHoy) %></strong>
          </div>
          <div class="stat">
            <span>Ventas registradas</span>
            <strong><%= ventasLista.length %></strong>
          </div>
          <div class="stat">
            <span>Productos disponibles</span>
            <strong><%= productosLista.length %></strong>
          </div>
          <div class="stat">
            <span>Estado</span>
            <strong>Activo</strong>
          </div>
        </div>

        <div class="sale-box">
          <form action="/ventas/nueva" method="POST">
            <div class="grid-4">
              <div class="field">
                <label for="productoId">Producto</label>
                <select name="productoId" id="productoId" required>
                  <option value="">Seleccionar producto</option>
                  <% productosLista.forEach(producto => { %>
                    <option value="<%= producto._id %>">
                      <%= producto.nombre %> | Stock: <%= Number(producto.stock || 0) %> | $<%= money(producto.precioVenta) %>
                    </option>
                  <% }) %>
                </select>
              </div>

              <div class="field">
                <label for="cantidad">Cantidad</label>
                <input type="number" id="cantidad" name="cantidad" min="1" value="1" required>
              </div>

              <div class="field">
                <label for="metodoPago">Método de pago</label>
                <select name="metodoPago" id="metodoPago">
                  <option>Efectivo</option>
                  <option>Transferencia</option>
                  <option>Mercado Pago</option>
                  <option>Otro</option>
                </select>
              </div>

              <div class="field">
                <label for="observacion">Observación</label>
                <input type="text" id="observacion" name="observacion" placeholder="Opcional">
              </div>
            </div>

            <div style="margin-top:16px;">
              <button type="submit" class="btn-main">✅ Registrar Venta</button>
            </div>
          </form>
        </div>

        <div class="search">
          <input type="text" id="buscadorVentas" placeholder="Buscar en el historial de ventas...">
        </div>

        <div class="table-wrap">
          <table id="tablaVentas">
            <thead>
              <tr>
                <th>Fecha</th>
                <th>Producto</th>
                <th>Cantidad</th>
                <th>P. Unitario</th>
                <th>Total</th>
                <th>Pago</th>
                <th>Obs.</th>
              </tr>
            </thead>
            <tbody>
              <% if (ventasLista.length > 0) { %>
                <% ventasLista.forEach(venta => { %>
                  <tr>
                    <td><%= new Date(venta.fecha).toLocaleDateString('es-AR') %></td>
                    <td class="product-cell"><%= venta.nombreProducto %></td>
                    <td><%= Number(venta.cantidad || 0) %></td>
                    <td>$<%= money(venta.precioUnitario) %></td>
                    <td class="total-cell">$<%= money(venta.total) %></td>
                    <td><%= venta.metodoPago || '-' %></td>
                    <td><%= venta.observacion && venta.observacion.trim() ? venta.observacion : '-' %></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="empty">Todavía no hay ventas registradas.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    Todos los derechos reservados - M.L DESARROLLOS WEB.
  </footer>

  <script>
    const buscadorVentas = document.getElementById('buscadorVentas');
    const filasVentas = document.querySelectorAll('#tablaVentas tbody tr');

    if (buscadorVentas) {
      buscadorVentas.addEventListener('input', () => {
        const texto = buscadorVentas.value.toLowerCase().trim();
        filasVentas.forEach(fila => {
          const contenido = fila.textContent.toLowerCase();
          fila.style.display = contenido.includes(texto) ? '' : 'none';
        });
      });
    }
  </script>
</body>
</html>