<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Nuevo Producto | JP</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    :root{
      --jp-primary:#223a73;
      --jp-primary-2:#2f4f9a;
      --jp-bg:#f4f7fc;
      --jp-text:#1f2937;
      --jp-muted:#6b7280;
      --jp-success:#159447;
      --jp-border:#d9e2f1;
      --jp-shadow:0 10px 30px rgba(27,47,95,.10);
    }

    *{ box-sizing:border-box; }

    body{
      margin:0;
      min-height:100vh;
      font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      color:var(--jp-text);
      background:linear-gradient(180deg,#f8fbff 0%, var(--jp-bg) 100%);
      position:relative;
    }

    body::before{
      content:"";
      position:fixed;
      inset:0;
      background-image:url('/images/logo-jp.png');
      background-repeat:repeat;
      background-size:110px;
      opacity:.03;
      pointer-events:none;
    }

    .topbar,.wrap,.footer{ position:relative; z-index:1; }

    .topbar{
      background:linear-gradient(135deg, var(--jp-primary), var(--jp-primary-2));
      color:#fff;
      padding:20px 0;
      box-shadow:0 10px 24px rgba(34,58,115,.18);
    }

    .brand{
      display:flex;
      align-items:center;
      justify-content:center;
      gap:14px;
      flex-wrap:wrap;
      text-align:center;
    }

    .brand img{
      width:72px;
      height:72px;
      border-radius:50%;
      background:#fff;
      padding:4px;
    }

    .brand h1{
      margin:0;
      font-size:clamp(1.4rem,3vw,2rem);
      font-weight:800;
    }

    .brand p{
      margin:4px 0 0;
      opacity:.9;
    }

    .page{
      max-width:1080px;
      margin:28px auto;
      padding:0 16px;
    }

    .panel{
      background:rgba(255,255,255,.94);
      border:1px solid var(--jp-border);
      border-radius:28px;
      box-shadow:var(--jp-shadow);
      overflow:hidden;
    }

    .head{
      padding:24px 28px;
      border-bottom:1px solid var(--jp-border);
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      gap:16px;
      flex-wrap:wrap;
    }

    .head h2{
      margin:0;
      color:var(--jp-primary);
      font-size:clamp(1.4rem,2.4vw,2rem);
      font-weight:800;
    }

    .head p{
      margin:6px 0 0;
      color:var(--jp-muted);
    }

    .actions{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
    }

    .btn-soft,
    .btn-main{
      border:none;
      border-radius:999px;
      padding:12px 18px;
      font-weight:700;
      text-decoration:none;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
    }

    .btn-soft{
      background:#fff;
      color:var(--jp-primary);
      box-shadow:0 8px 18px rgba(34,58,115,.10);
    }

    .btn-main{
      background:linear-gradient(135deg, var(--jp-success), #20b45a);
      color:#fff;
      box-shadow:0 10px 20px rgba(21,148,71,.18);
    }

    .body{
      padding:24px 28px 28px;
    }

    form{
      display:grid;
      gap:18px;
    }

    .grid-2{
      display:grid;
      grid-template-columns:repeat(2, minmax(0,1fr));
      gap:16px;
    }

    .grid-4{
      display:grid;
      grid-template-columns:repeat(4, minmax(0,1fr));
      gap:16px;
    }

    .field{
      display:flex;
      flex-direction:column;
      gap:7px;
    }

    .field label{
      font-size:.92rem;
      font-weight:700;
      color:#43506a;
    }

    .field input,
    .field textarea{
      width:100%;
      border:1px solid #c8d3e4;
      border-radius:14px;
      padding:14px 15px;
      font-size:1rem;
      background:#fff;
      color:var(--jp-text);
      outline:none;
    }

    .field textarea{
      min-height:120px;
      resize:vertical;
    }

    .field input:focus,
    .field textarea:focus{
      border-color:#7ea7ff;
      box-shadow:0 0 0 4px rgba(126,167,255,.14);
    }

    .bottom-actions{
      display:flex;
      gap:12px;
      flex-wrap:wrap;
    }

    .footer{
      text-align:center;
      padding:18px 12px 28px;
      color:#53627f;
      font-weight:600;
    }

    @media (max-width: 900px){
      .grid-2{ grid-template-columns:1fr; }
      .grid-4{ grid-template-columns:repeat(2, minmax(0,1fr)); }
    }

    @media (max-width: 600px){
      .head,.body{ padding:18px; }
      .grid-4{ grid-template-columns:1fr; }
      .actions,.bottom-actions{ flex-direction:column; }
      .btn-soft,.btn-main{ width:100%; }
    }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="container brand">
      <img src="/images/logo-jp.png" alt="Logo JP">
      <div>
        <h1>JP Entrenamiento Personalizado</h1>
        <p>Alta de productos</p>
      </div>
    </div>
  </header>

  <main class="page wrap">
    <section class="panel">
      <div class="head">
        <div>
          <h2>➕ Nuevo producto</h2>
          <p>Carga un producto nuevo para dejarlo listo para la venta.</p>
        </div>

        <div class="actions">
          <a href="/productos" class="btn-soft">← Volver</a>
          <a href="/ventas" class="btn-soft">💰 Ir a Ventas</a>
        </div>
      </div>

      <div class="body">
        <form action="/productos/nuevo" method="POST">
          <div class="grid-2">
            <div class="field">
              <label for="nombre">Nombre del producto</label>
              <input type="text" id="nombre" name="nombre" placeholder="Ej: Proteína Whey 1kg" required>
            </div>

            <div class="field">
              <label for="categoria">Categoría</label>
              <input type="text" id="categoria" name="categoria" placeholder="Ej: Suplementos">
            </div>
          </div>

          <div class="field">
            <label for="descripcion">Descripción</label>
            <textarea id="descripcion" name="descripcion" placeholder="Ej: sabor vainilla, marca X, presentación 1kg"></textarea>
          </div>

          <div class="grid-4">
            <div class="field">
              <label for="precioCompra">Precio de compra</label>
              <input type="number" step="0.01" id="precioCompra" name="precioCompra" placeholder="0.00">
            </div>

            <div class="field">
              <label for="precioVenta">Precio de venta</label>
              <input type="number" step="0.01" id="precioVenta" name="precioVenta" placeholder="0.00" required>
            </div>

            <div class="field">
              <label for="stock">Stock inicial</label>
              <input type="number" id="stock" name="stock" placeholder="0" required>
            </div>

            <div class="field">
              <label for="stockMinimo">Stock mínimo</label>
              <input type="number" id="stockMinimo" name="stockMinimo" value="0">
            </div>
          </div>

          <div class="bottom-actions">
            <button type="submit" class="btn-main">✅ Guardar Producto</button>
            <a href="/productos" class="btn-soft">📦 Ver Listado</a>
          </div>
        </form>
      </div>
    </section>
  </main>

  <footer class="footer">
    Todos los derechos reservados - M.L DESARROLLOS WEB.
  </footer>
</body>
</html>